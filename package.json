{
  "name": "obsidian-memory",
  "version": "0.1.0",
  "description": "Universal memory layer for AI coding agents, powered by Obsidian",
  "type": "module",
  "bin": {
    "obsidian-memory": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun --minify && chmod +x dist/index.js",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "obsidian",
    "memory",
    "ai",
    "coding-agent",
    "claude-code",
    "cursor",
    "context",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/enjat/obsidian-memory"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.4",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "author": "enjat",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
